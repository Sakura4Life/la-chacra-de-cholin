  m_Script: {fileID: 11500000, guid: fbb8ca9f116e21d48a704604e599aa60, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MisionController
  tomatesPedido: 3
  semillasTomateIniciales: 12
  textoSemillas: "Cholin:\n\nAqu\xED tienes tus primeras {0} semillas de tomate.
    Si\xE9mbralas en los huecos del huerto, ri\xE9galas con la regadera y espera
    a que crezcan."
  textoPedido: 'Pedido de la pizarra:


    Entrega {0} tomates en la caja de entrega.'
  textoPollito: "Nota nueva:\n\nSe escap\xF3 el pollito de la granja. Escucha con
    atenci\xF3n: debe estar cerca."
  textoGallinero: "Nota:\n\nEl pollito est\xE1 a salvo contigo. Ll\xE9valo al gallinero
    para que crezca."
  textoLibre: "Nota:\n\nLa chacra est\xE1 viva otra vez. Cuida tus cultivos y a tu
    pollito."
